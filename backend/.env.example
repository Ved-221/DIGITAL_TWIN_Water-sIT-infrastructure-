# ==============================================================================
# InfraTwin Backend Environment Configuration
# ==============================================================================

# Data Source Switch:
# - "demo"   : Uses baseline seeded enterprise infrastructure (Empower, ERP, etc.)
# - "aws"    : Ingests infrastructure live from your AWS account on startup
# - "hybrid" : Seeds baseline data and overlays live AWS infrastructure
INFRATWIN_DATA_SOURCE=demo

# AWS Credentials (Standard AWS SDK resolution)
# NOTE: Never commit production credentials to Git!
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SESSION_TOKEN=optional-session-token-for-temporary-credentials
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# Gemini AI API Key (For natural language explanations)
GEMINI_API_KEY=your-gemini-api-key
